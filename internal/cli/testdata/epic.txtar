# S6 epic lifecycle: create through the atomic six-condition close.

seeddb
expectexit 0 selftracked epic create demo-run --goal 'prove the machinery'
stdout 'BACKLOG'
expectexit 1 selftracked epic create BadSlug --goal g
stderr 'kebab-case'
expectexit 1 selftracked epic create no-goal
stderr 'requires --goal'

# BACKLOG cannot close - it never ran; dissolve is its exit.
expectexit 1 selftracked epic close demo-run
stderr 'never ran'

expectexit 0 selftracked epic activate demo-run
expectexit 0 selftracked epic pause demo-run --why 'waiting on budget'
expectexit 0 selftracked epic activate demo-run
expectexit 1 selftracked epic pause demo-run
stderr 'requires --why'

# The complete blocker list: a close attempt on an unready epic names
# EVERY blocker at once (cardinality, open stories, criteria, tasks).
expectexit 0 selftracked story add demo-run --title 'first increment'
expectexit 0 selftracked criteria add demo-run --text '$ true'
expectexit 0 selftracked create --title homed --status OPEN --epic demo-run
expectexit 1 selftracked epic close demo-run
stderr '\(6\)'
stderr '\(1\) story S1 is not terminal'
stderr '\(4\)'

# edit's S6 half: the epic goal, with the bounded old-new event.
expectexit 0 selftracked edit epic:demo-run --goal 'prove it end to end'
grep 'goal: prove the machinery' .selftracked/dump.sql
expectexit 1 selftracked edit epic:demo-run --title nope
stderr 'takes --goal'

# Ready the epic: two DONE stories, met criteria, task detached.
expectexit 0 selftracked story add demo-run --title 'second increment'
expectexit 0 selftracked edit epic:demo-run/S1 --dod '$ true'
expectexit 0 selftracked edit epic:demo-run/S2 --dod '$ true'
expectexit 0 selftracked story ready demo-run S1
expectexit 0 selftracked story start demo-run S1
expectexit 0 selftracked story done demo-run S1 --commits abc123 --gate 'go test'
expectexit 0 selftracked story ready demo-run S2
expectexit 0 selftracked story start demo-run S2
expectexit 0 selftracked story done demo-run S2 --commits def456 --gate 'go test'
expectexit 0 selftracked edit 2 --detach
expectexit 0 selftracked epic close demo-run
stdout 'CLOSED'

# Closed is terminal: no reopen path exists for epics.
expectexit 1 selftracked epic activate demo-run
stderr 'illegal epic transition'

# active_verb never leaks into the dump (the close wrote and deleted it
# inside one transaction).
! grep 'VALUES ..active_verb' .selftracked/dump.sql

# epic dissolve: preconditions, then the auto-DISSOLVE cascade with a
# worklog row per story, all in one transaction.
expectexit 0 selftracked epic create doomed --goal g
expectexit 0 selftracked epic activate doomed
expectexit 0 selftracked story add doomed --title a
expectexit 0 selftracked story add doomed --title b
expectexit 0 selftracked edit epic:doomed/S1 --dod '$ true'
expectexit 0 selftracked story ready doomed S1
expectexit 0 selftracked story start doomed S1
expectexit 0 selftracked create --title clinger --status OPEN --epic doomed

# refuses while a story is IN-PROGRESS and a task is homed; a PARKED
# homed task gets the unpark/detach remedy in its blocker line.
expectexit 0 selftracked park 3 --why 'later'
expectexit 1 selftracked epic dissolve doomed --why 'pivoted'
stderr 'S1 is IN-PROGRESS'
stderr '#3'
stderr 'unpark it or edit --detach'

# clear the blockers; the cascade auto-DISSOLVES PLANNED/READY/BLOCKED
# stories, each with its own worklog row.
expectexit 0 selftracked story block doomed S1 --reason 'giving up'
expectexit 0 selftracked edit 3 --detach
expectexit 0 selftracked epic dissolve doomed --why 'pivoted'
stdout 'DISSOLVED'
grep 'DISSOLVED., .., .., .., NULL, .auto-dissolved with the epic: pivoted' .selftracked/dump.sql

# epic show --json is ONE JSON document (task #6): the sections ride
# inside the object, never as plain-text lines after a JSON header.
expectexit 0 selftracked epic show demo-run --json
stdout '"stories":\['
stdout '"criteria":\['
stdout '"worklog":\['
! stdout '  stories: '
