# S6 story machine: WIP, DoR, the no-DoD refusal, unblock's verbatim
# resolution, done's atomic pair, dissolve - and the dump diff shapes.

seeddb
expectexit 0 selftracked epic create flow --goal g
expectexit 0 selftracked epic activate flow
expectexit 0 selftracked story add flow --title one
expectexit 0 selftracked story add flow --title two

# ready needs only DoR (PLANNED's empty blocked field); a DoD may be set
# but is not required (an over-strict gate was removed at close review).
expectexit 0 selftracked edit epic:flow/S1 --dod '$ go test ./...'
expectexit 0 selftracked story ready flow S1
expectexit 0 selftracked story ready flow S2

# Wrong-source refusals: ready only from PLANNED, and a re-affirming
# call cannot append a duplicate episode (INV-119).
expectexit 1 selftracked story ready flow S1
stderr wrong-state

# WIP=1 per epic: the second start refuses naming the occupant.
expectexit 0 selftracked story start flow S1
expectexit 1 selftracked story start flow S2
stderr 'WIP limit: story S1'

# block requires a reason; unblock requires a resolution recorded
# verbatim in the events row (the PO: convention rides the text).
expectexit 0 selftracked story block flow S1 --reason 'PO decision pending'
expectexit 1 selftracked story unblock flow S1
stderr 'requires --resolution'
expectexit 0 selftracked story unblock flow S1 --resolution 'PO: use the webhook channel (chat, 2026-07-20)'
grep 'PO: use the webhook channel' .selftracked/dump.sql

# story done: both flags required, the flip and its worklog row land as
# a 3-line diff (story + worklog + events, INV-332).
expectexit 0 selftracked story start flow S1
expectexit 1 selftracked story done flow S1 --commits abc
stderr 'requires --commits and --gate'
cp .selftracked/dump.sql before-done.sql
expectexit 0 selftracked story done flow S1 --commits abc123..def456 --gate 'make gates'
dumpdiff before-done.sql .selftracked/dump.sql 1 3

# unblock's two-line shape (INV-333): story line + events line.
expectexit 0 selftracked story start flow S2
expectexit 0 selftracked story block flow S2 --reason external-outage
cp .selftracked/dump.sql before-unblock.sql
expectexit 0 selftracked story unblock flow S2 --resolution 'outage cleared at 09:14'
dumpdiff before-unblock.sql .selftracked/dump.sql 1 2

# DONE is terminal: rework is a NEW story, never a reopened old one.
# The verb's source guard catches it before the schema trigger would.
expectexit 1 selftracked story ready flow S1
stderr 'S1 is DONE'

# dissolve appends its own worklog row.
expectexit 0 selftracked story start flow S2
expectexit 0 selftracked story dissolve flow S2 --why 'superseded by S3'
grep 'DISSOLVED., .., .., .., NULL, .superseded by S3' .selftracked/dump.sql
