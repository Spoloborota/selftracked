# S5a create: happy path and every documented refusal.

seeddb
expectexit 0 selftracked create --title 'from the CLI'
stdout '#2'

# --json prints the ref object.
expectexit 0 selftracked create --title another --json
stdout '\{"ref":"#3"\}'

# Refusals: no title; terminal status; label+status; control characters.
expectexit 1 selftracked create
stderr 'requires --title'
expectexit 1 selftracked create --title x --status DONE
stderr 'terminal statuses exist only via import'
expectexit 1 selftracked create --title x --status DUPLICATE
stderr 'terminal statuses exist only via import'
expectexit 1 selftracked create --title x --label --status OPEN
stderr 'mutually exclusive'

# create --note lands in the status_note column.
expectexit 0 selftracked create --title noted --status OPEN --note 'why it exists'
grep 'why it exists' .selftracked/dump.sql

# #26: the usage line names the status default. Bare `create` lands
# NEEDS-TRIAGE, but an alternation that merely lists three statuses reads as
# if the first were the default — two agents in a row assumed OPEN. The
# parenthetical is asserted here, at the surface an agent actually reads at
# the moment of the call, and section 6.2's `create` row is what it implements.
expectexit 0 selftracked create -h
stdout '--status OPEN\|IN-REVIEW\|NEEDS-TRIAGE \(default NEEDS-TRIAGE\)'

# No verb accepts a caller-supplied date (INV-055): unknown flag, exit 2.
expectexit 2 selftracked create --title x --date 2020-01-01
stderr 'usage'

# The write landed in the dump and the events tail (INV-330/331 shape).
grep 'from the CLI' .selftracked/dump.sql
grep 'selftracked dump schema_version=1 tasks=4' .selftracked/dump.sql
