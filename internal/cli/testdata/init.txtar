# S8a init: the CLI contract — fresh init scaffolds a green tracker, the
# gitignore covers the right files, no config file is created, and --force
# gates re-initialization. Driven through the real binary.

exec git init

# A fresh init succeeds and immediately verifies green (INV-402/493). On a
# clean repo init prints the takeover command (INV-419); the hooks are now
# generated but inactive until the owner activates them, so verify stays 0.
expectexit 0 selftracked init
stdout 'initialized selftracked'
stdout 'git config core.hooksPath \.selftracked/hooks'
expectexit 0 selftracked verify

# Layout (§9): the tracked surface, the generated docs, and the tracked
# hooks exist (INV-396/399/400/401).
exists .selftracked/dump.sql
exists STATE.md
exists PROMPT.md
exists AGENTS.md
exists docs/decisions/_template.md
exists .claude/settings.json
exists .selftracked/hooks/pre-commit
exists .selftracked/hooks/post-commit

# .gitignore covers the local files and NOT the tracked dump or the tracked
# hooks (INV-397/398/401/417).
grep '\.selftracked/db\.sqlite' .gitignore
grep '\.selftracked/dump\.hash' .gitignore
grep '\.selftracked/skip-pending' .gitignore
! grep 'dump\.sql$' .gitignore
! grep 'hooks' .gitignore

# No config file exists — configuration lives in meta (INV-545).
! exists selftracked.toml
! exists selftracked.json
! exists .selftracked/config

# A seeded root exists so verify's R2 is green (INV-064).
exists docs/research

# Re-init without --force refuses (INV-188); with --force it refreshes
# (the database is preserved — see the Go test).
expectexit 1 selftracked init
stderr 'already exists'
expectexit 0 selftracked init --force

# A clone — tracked dump.sql, no local db.sqlite — must refuse and point at
# load rather than overwrite the tracked state, even with --force.
mkdir clone/.selftracked
cp clonedump.txt clone/.selftracked/dump.sql
cd clone
expectexit 1 selftracked init
stderr 'run selftracked load'
expectexit 1 selftracked init --force
grep 'tracked state to keep' .selftracked/dump.sql
cd ..

-- clonedump.txt --
-- tracked state to keep

