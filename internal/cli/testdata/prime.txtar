# S8c prime: the §11.1 JSON contract through the real binary. A fresh init
# emits every list empty and both §8 booleans false; a created task lands in
# the triage queue; a moved tracked dump flips dump_divergence read-only.

exec git init
expectexit 0 selftracked init

# A fresh tracker: the stable contract shape, all lists empty, no divergence.
expectexit 0 selftracked prime --json
stdout '"epics_active":\[\]'
stdout '"ready":\[\]'
stdout '"triage":\[\]'
stdout '"in_review":\[\]'
stdout '"sprint_goals":\[\]'
stdout '"notices":\[\]'
stdout '"totals":\{'
stdout '"dump_divergence":false'
stdout '"dump_requires_newer_binary":false'
# migrated is omitempty and absent when nothing migrated (S8c never migrates).
! stdout 'migrated'

# A created task appears in the triage queue with its ref, no title prose.
expectexit 0 selftracked create --title 'triage this'
expectexit 0 selftracked prime --json
stdout '"triage":\["#1"\]'
! stdout 'triage this'

# prime without --json is a human digest, not the contract.
expectexit 0 selftracked prime
stdout 'triage: 1'

# §11.1's notices[]: an ACTIVE epic with no story that can receive work is
# named, not left to be inferred from `sprint goals: 0`. Through the real
# verbs — `epic create` + `epic activate` — so the notice is asserted against
# the state a user can actually reach.
expectexit 0 selftracked epic create homeless --goal 'nothing can be recorded here'
expectexit 0 selftracked epic activate homeless
expectexit 0 selftracked prime --json
stdout '"notices":\[\{"code":"no-workable-story","epic":"homeless"\}\]'
# The typed notice sits between sprint_goals[] and totals{} (field order is
# part of the contract), and the epic's tally now carries `planned`.
stdout '"sprint_goals":\[\],"notices":\[\{"code":"no-workable-story","epic":"homeless"\}\],"totals":\{'
stdout '"stories":\{"done":0,"in_progress":0,"planned":0,"ready":\[\],"blocked":\[\]\}'

# The digest says it in a sentence, before the counter line. The slug is
# %q-quoted: it is interpolated into fluent English and `import` can mint one
# with any shape at all, so the boundary between sentence and data is drawn.
expectexit 0 selftracked prime
stdout 'notice: epic "homeless" has no story that can receive work — new work has no home; opening a story is the owner''s call'

# A PLANNED story is a home: the notice goes silent and `planned` counts it —
# without that field this epic and an empty one would render identically.
expectexit 0 selftracked story add homeless --title 'the home'
expectexit 0 selftracked prime --json
stdout '"notices":\[\]'
stdout '"stories":\{"done":0,"in_progress":0,"planned":1,"ready":\[\],"blocked":\[\]\}'
expectexit 0 selftracked prime
! stdout 'notice: epic homeless'

# A moved tracked dump (a pull) flips dump_divergence — read-only: prime must
# not rewrite the dump it reports on.
cp .selftracked/dump.sql dump.before
exec sh -c 'printf -- "-- pulled\n" | cat - .selftracked/dump.sql > dump.moved && cp dump.moved .selftracked/dump.sql'
expectexit 0 selftracked prime --json
stdout '"dump_divergence":true'
cmp .selftracked/dump.sql dump.moved
