# S6 criteria: runnable vs owner-attested, the regression flip, exit 1.

seeddb
expectexit 0 selftracked epic create crit --goal g
expectexit 0 selftracked criteria add crit --text '$ true'
expectexit 0 selftracked criteria add crit --text 'the owner has read the report'
expectexit 0 selftracked criteria add crit --text '$ false'

# check executes runnables, records evidence, exits 1 on failure.
expectexit 1 selftracked criteria check crit
stdout 'criterion 1: PASS'
stdout 'criterion 3: FAIL'
grep 'PASS true @' .selftracked/dump.sql

# met is for owner-attested criteria only; runnables refuse.
expectexit 1 selftracked criteria met crit 1 --evidence anything
stderr 'only judge'
expectexit 0 selftracked criteria met crit 2 --evidence 'confirmed in review 2026-07-20'
expectexit 1 selftracked criteria met crit 3
stderr 'requires --evidence'

# The regression flip (INV-228), driven for real: a runnable criterion
# passes (met=1), then its condition breaks and a re-check flips met 1->0.
expectexit 0 selftracked epic create flip --goal g
expectexit 0 selftracked criteria add flip --text '$ test -f probe.flag'
exec touch probe.flag
expectexit 0 selftracked criteria check flip
grep 'PASS test -f probe.flag' .selftracked/dump.sql
exec rm probe.flag
expectexit 1 selftracked criteria check flip
grep 'FAIL test -f probe.flag' .selftracked/dump.sql
# The dump carries met=0 for that criterion now (the flip landed).
grep 'flip., 1, .. test -f probe.flag., 0,' .selftracked/dump.sql

# The standalone check exits 1 only for a FAILED RUNNABLE criterion: an
# unmet owner-attested criterion is close condition (3)'s business, not a
# check failure (task #7 - the shared blocker list used to make this
# case claim 'a runnable criterion failed' with every runnable green).
expectexit 0 selftracked epic create attested --goal g
expectexit 0 selftracked criteria add attested --text '$ true'
expectexit 0 selftracked criteria add attested --text 'the owner still has homework'
expectexit 0 selftracked criteria check attested
stdout 'criterion 1: PASS'
